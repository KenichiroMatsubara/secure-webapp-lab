{
  "name": "secure-webapp-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "安全なWebアプリケーションの作り方（第4〜5章相当）を手を動かして学ぶ、Cloudflare Workers 製の脆弱性ハンズオン教材",
  "scripts": {
    "gen": "tsx scripts/gen-sources.ts",
    "dev": "wrangler dev --var ENVIRONMENT:development",
    "pretest": "npm run gen",
    "test": "vitest run",
    "typecheck": "npm run gen && tsc --noEmit -p . && tsc --noEmit -p scripts && tsc --noEmit -p test",
    "check:egress": "tsx scripts/check-no-egress.ts",
    "predeploy": "npm run gen && npm run check:egress",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@cloudflare/workers-types": "^5.20261012.1",
    "@types/diff": "^7.0.2",
    "@types/node": "^22.20.5",
    "diff": "^8.0.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.149.0"
  },
  "engines": {
    "node": ">=20"
  }
}
